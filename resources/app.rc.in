#include "resource.h"
#include <windows.h>

#pragma code_page(65001)

// 1. Core Application Icon (IDI_APP_ICON = 101)
IDI_APP_ICON    ICON    "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

// 2. Version Information (Single Source of Truth from CMakeLists.txt)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "CKCat Studio"
            VALUE "FileDescription",  "SitStandReminder - Scientific Sit-Stand & Ergonomic Assistant"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "SitStandReminder"
            VALUE "LegalCopyright",   "Copyright (C) 2026 CKCat. All rights reserved."
            VALUE "OriginalFilename", "SitStandReminder.exe"
            VALUE "ProductName",      "SitStandReminder"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

